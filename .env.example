# --- GPT service ---
# Required: API key sent as body field `key`
EDWISE_GPT_KEY=

# Host or full API root (no trailing secrets)
EDWISE_GPT_BASE=https://your-gpt-service.example.com/gpt-service/api/v1

# Optional Bearer token for the GPT gateway
EDWISE_GPT_AUTH_TOKEN=

# Example engines: gpt-5.6-luna, gpt-5.4, claude-sonnet-5
EDWISE_GPT_ENGINE=gpt-5.6-luna

GPT_POLL_DELAY_MS=5000
GPT_MAX_POLLS=240

# --- Media ---
EDWISE_MEDIA_BASE=https://your-backend.example.com/api/media2
EDWISE_GENMEDIA_BASE=https://your-genmedia-service.example.com/api
MEDIA_SERVICE_BASE_URL=https://your-genmedia-service.example.com
MEDIA_PHOTO_ENGINE=geminipro3
MEDIA_POLL_INTERVAL_MS=2000
MEDIA_MAX_WAIT_MS=120000
